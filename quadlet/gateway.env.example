# Falcon Gateway environment — copy to /etc/falcon/gateway.env, chmod 600.
#
# Referenced by the Quadlet units as `EnvironmentFile=-/etc/falcon/gateway.env`.
# systemd performs NO variable expansion inside `Environment=`, so every value
# a unit needs must be spelled out here under its final name.
#
# Never commit the real file. Only this example belongs in git.

# Grafana admin password. Without this Grafana falls back to admin/admin.
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# External URL Grafana is reached on, including the /grafana sub-path.
# Must match the address LAN clients use, or Grafana's redirects will point
# somewhere unreachable.
GF_SERVER_ROOT_URL=http://192.0.2.10:8880/grafana/

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME

# Token falcon-trader requires; the canary exporter sends it as a bearer token.
FALCON_API_TOKEN=CHANGE_ME
