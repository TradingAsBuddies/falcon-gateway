# grafana.container
# Grafana dashboards for Falcon Gateway
#
# Location:
#   - Local dev: ~/.config/containers/systemd/
#   - Production: /etc/containers/systemd/

[Unit]
Description=Grafana Dashboards (Falcon Gateway)
After=prometheus.service

[Container]
Image=docker.io/grafana/grafana:10.2.0
ContainerName=falcon-grafana
Network=falcon.network

# Port
PublishPort=3000:3000

# Data and provisioning
Volume=falcon-grafana-data:/var/lib/grafana:Z
# For production, also mount provisioning:
# Volume=/etc/falcon/grafana/provisioning:/etc/grafana/provisioning:ro

# Environment
#
# Secrets and the external URL come from this file, not from git. The `-`
# prefix makes it optional so the unit still starts without it -- but Grafana
# then falls back to admin/admin, so create it before exposing the gateway.
#   /etc/falcon/gateway.env   (see gateway.env.example)
EnvironmentFile=-/etc/falcon/gateway.env

# NOTE: systemd does NOT expand variables inside Environment=. An earlier
# revision here set GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD},
# which passes that string to Grafana *literally*. The password must therefore
# be supplied by EnvironmentFile as GF_SECURITY_ADMIN_PASSWORD itself.
Environment=GF_USERS_ALLOW_SIGN_UP=false

# Serve correctly behind the /grafana stripPrefix router. Without these,
# Grafana emits absolute asset and redirect URLs rooted at "/", which the
# lan-catchall router then hands to the trading dashboard.
#
# %(protocol)s / %(domain)s are Grafana's OWN ini-file interpolation syntax and
# are not valid in a systemd unit -- systemd reads % as a specifier prefix and
# fails to start on the unknown specifier. The URL must be a literal. Override
# GF_SERVER_ROOT_URL in gateway.env with the address the LAN actually uses.
Environment=GF_SERVER_ROOT_URL=http://localhost:8880/grafana/
Environment=GF_SERVER_SERVE_FROM_SUB_PATH=true

# Labels
Label=project=falcon
Label=service=grafana

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target default.target
