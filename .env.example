# Falcon Gateway Environment Variables
# Copy to .env and update values for your environment

# PostgreSQL
POSTGRES_USER=falcon
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=falcon
DB_HOST=falcon-postgresql
DB_PORT=5432

# PostgreSQL Exporter DSN
DATA_SOURCE_NAME=postgresql://falcon:CHANGE_ME@falcon-postgresql:5432/falcon?sslmode=disable

# Grafana. No default -- set a real value. This file previously shipped
# "falcon123", which meant every deployment that copied it shared one password.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Environment label for Prometheus
ENVIRONMENT=dev

# Falcon Messenger
FALCON_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
FALCON_BLUESKY_HANDLE=your-handle.bsky.social
FALCON_BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
