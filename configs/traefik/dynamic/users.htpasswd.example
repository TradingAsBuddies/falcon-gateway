# Example basic-auth users file for the `dashboard-auth` middleware
# (configs/traefik/dynamic/routes.yml).
#
# Copy this file to users.htpasswd in the same directory and replace the
# placeholder below with real entries. users.htpasswd is gitignored and
# must never be committed.
#
# Generate an entry with a bcrypt hash:
#   htpasswd -nbB falcon 'your-password-here'
#
# The line below is a NON-FUNCTIONAL placeholder, not a usable credential.
# Traefik will reject it; replace it before enabling auth.
changeme:$2y$05$REPLACE_THIS_PLACEHOLDER_WITH_A_REAL_BCRYPT_HASH
